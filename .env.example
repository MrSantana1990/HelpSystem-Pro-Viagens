# Copy to .env locally. Never commit real values.
APP_ENV=local
HOST=127.0.0.1
PORT=3001
PROVIDER_MODE=demo
# Unique name and port for each environment
COMPOSE_PROJECT_NAME=viagens-local
WEB_PORT=8094
# Optional data profile; replace both independently before starting it
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Used only by migrations; credentials must be URI encoded
DATABASE_URL=
